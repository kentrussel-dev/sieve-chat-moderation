# ==============================================================================
# Sieve: Git Ignore Rules
# ==============================================================================

# Environment & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js / Vite / Frontend
web/node_modules/
web/dist/
web/dist-ssr/
web/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Go Artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
/cmd/producer/producer
/cmd/tier1/tier1
/cmd/tier2/tier2
/cmd/benchmark/benchmark

# Kafka / Docker Runtime Data
kraft-combined-logs/
/tmp/kraft-combined-logs/
*.log

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Large Model / Exported Weights (optional local checkpoints)
models/*.pt
models/*.onnx
models/*.bin
