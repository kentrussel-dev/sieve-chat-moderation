# ==============================================================================
# Sieve: Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the production Docker stack or server.
# NEVER commit your actual .env file or production API keys to source control.

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0

# Apache Kafka Configuration
KAFKA_BROKERS=localhost:9092

# Dual-Mesh Threshold Calibration Bounds
# Uncertainty Band: [TAU_LOW, TAU_HIGH] -> Escalated to Tier 2 LLM
TAU_LOW=0.20
TAU_HIGH=0.80

# Frontier LLM API Key (Optional)
# If left empty, Tier 2 operates in high-fidelity offline simulation mode.
GEMINI_API_KEY=

# Local Tier 1 Inference Endpoint
CLASSIFIER_URL=http://localhost:8000/v1/classify

# Dataset Paths
CONDA_DATASET_PATH=data/conda_samples.json
SENSAI_DATASET_PATH=data/sensai_samples.json
